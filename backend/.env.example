# Local development defaults only. Never deploy this configuration unchanged.
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/omnipulse.db
JWT_SECRET=local-only-change-me-before-deployment
JWT_ISSUER=omnipulse-tv
JWT_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=128000

# Production authentication: configure Cognito access-token validation.
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

AI_PROVIDER=rules
BEDROCK_MODEL_ID=

# Licensed or free sports data provider: sample, api-football, opta, sportradar
SPORTS_PROVIDER=sample
SPORTS_PROVIDER_API_KEY=
